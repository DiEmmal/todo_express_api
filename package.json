{
  "name": "todo_api_express",
  "version": "1.0.0",
  "description": "A simple TODO API built with Express",
  "main": "app.js",
  "scripts": {
    "dev": "docker compose up -d && tsx --watch src/app.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "docker compose up -d && node dist/app.js",
    "docker": "docker compose up -d",
    "docker:test": "docker compose --env-file .env.test -f docker-compose.test.yml up -d",
    "test": "npm run docker:test && vitest"
  },
  "keywords": [],
  "author": "DiEmmal",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "env-var": "^7.5.0",
    "express": "^5.2.1",
    "mongoose": "^9.9.1"
  }
}
